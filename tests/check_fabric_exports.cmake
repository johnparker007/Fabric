if(WIN32)
  execute_process(COMMAND dumpbin /exports "${LIBRARY}" OUTPUT_VARIABLE exports RESULT_VARIABLE result)
else()
  execute_process(COMMAND nm -D --defined-only "${LIBRARY}" OUTPUT_VARIABLE exports RESULT_VARIABLE result)
endif()
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Could not inspect Fabric exports")
endif()
foreach(symbol FabricCreateRuntime FabricRuntimeGetLastError FabricCreateSession FabricSessionInitialise FabricSessionGetSnapshot FabricSessionReadAudio FabricDestroySession FabricDestroyRuntime)
  if(NOT exports MATCHES "${symbol}")
    message(FATAL_ERROR "Missing public export: ${symbol}")
  endif()
endforeach()
if(WIN32 AND exports MATCHES "FabricRegisterBackendProvider")
  message(FATAL_ERROR "Internal composition hook was exported: FabricRegisterBackendProvider")
endif()
